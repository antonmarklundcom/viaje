# viaje.com.py — repo-root deploy (hPanel → Advanced → GIT). Mirrors engine/htaccess.template
# with paths adjusted for the sites/viaje.com.py layout. Edit both together.

Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never serve repo internals. THE_REQUEST is the client's original request line, so
    # the internal /assets → sites/... rewrites below are not caught by this rule.
    RewriteCond %{THE_REQUEST} \s/(sites|tools|docs|prompts|dist|out|\.github|\.claude)(/|\s|\?)
    RewriteRule ^ - [F,L]
    RewriteRule ^engine/(?!assets/) - [F,L]
    # content-seed/ is the tracked seed copy of the site's content; never served (the
    # `sites` rule above already covers it, this one documents the intent and survives a reshuffle).
    RewriteRule ^sites/[^/]+/content-seed - [F,L]
    # IndexNow key file: /<key>.txt is answered by the engine (Router), not a static file.
    RewriteRule ^[A-Za-z0-9-]{16,128}\.txt$ index.php [L]
    # robots.txt is answered by the engine, so it is the one root .txt that must not be blocked.
    RewriteRule ^(?!robots\.txt$)[^/]+\.(md|json|jsonl|sh|txt|yml|yaml|lock)$ - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Site assets and uploads live under sites/viaje.com.py but are addressed from the root.
    RewriteRule ^media/(.*)$ sites/viaje.com.py/media/$1 [L]
    RewriteRule ^assets/(.*)$ sites/viaje.com.py/assets/$1 [L]
    RewriteRule ^theme\.css$ sites/viaje.com.py/theme.css [L]

    # Everything that is not a real file or directory goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php !-f
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|jpe?g|png|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>
