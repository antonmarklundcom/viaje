# {{DOMAIN}} — generated by tools/build.php. Edit engine/htaccess.template, not this file.

Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTPS and host canonicalisation are handled in PHP (spec §5) so they stay
    # portable across Apache and LiteSpeed. The Apache-native variant, for reference:
    #   RewriteCond %{HTTPS} off
    #   RewriteRule ^(.*)$ https://{{HOST}}/$1 [R=301,L]

    # Never serve engine sources or site internals.
    RewriteRule ^engine/(?!assets/) - [F,L]
    RewriteRule ^site/(content|data|cache)/ - [F,L]
    RewriteRule ^site/.*\.(php|md|json|jsonl|txt)$ - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Uploads and site assets live under site/ but are addressed from the root.
    RewriteRule ^media/(.*)$ site/media/$1 [L]
    RewriteRule ^assets/(.*)$ site/assets/$1 [L]
    RewriteRule ^theme\.css$ site/theme.css [L]

    # Everything that is not a real file or directory goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]

    # Directory requests without an index file are routed to PHP too.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.php !-f
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|jpe?g|png|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>
